{
  "name": "ndjson-http-api",
  "version": "1.0.0",
  "description": "HTTP JSON API over an NDJSON dataset on the built-in node:http module",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node main.js -i mtcars.json -h 127.0.0.1 -p 3000",
    "dev": "node --watch main.js -i mtcars.json -h 127.0.0.1 -p 3000"
  },
  "author": "Sviatoslav Didukh",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0"
  }
}
